# Copy this file to .env and replace the placeholders with your Atlas values.
PORT=3000
MONGODB_DB_NAME=DB_23IT209
MONGODB_READ_URI=mongodb+srv://READ_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=BookManagement
MONGODB_WRITE_URI=mongodb+srv://WRITE_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=BookManagement
SESSION_SECRET=replace_with_a_long_random_secret